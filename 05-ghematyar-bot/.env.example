# ---------------------------------------------------------------------------
# قیمت‌یار — نمونهٔ متغیرهای محیطی
# این فایل را به .env کپی کنید یا مقادیر را در پنل سرویس وارد کنید.
# هیچ مقدار حساسی نباید داخل مخزن قرار بگیرد.
# ---------------------------------------------------------------------------

# --- تلگرام (الزامی) --------------------------------------------------------
# توکن را از @BotFather بگیرید
TELEGRAM_TOKEN=

# --- حالت webhook (تولید) ---------------------------------------------------
# روی Render به‌صورت خودکار از RENDER_EXTERNAL_URL پر می‌شود
# WEBHOOK_BASE_URL=https://example.onrender.com
# WEBHOOK_PATH=/tg-webhook
# TELEGRAM_WEBHOOK_SECRET=یک-مقدار-تصادفی
PORT=10000

# محدودکردن دستورهای مدیریتی به این شناسه‌ها (خالی = همه)
# ADMIN_IDS=123456789,987654321

# --- لایهٔ داده -------------------------------------------------------------
# کش کوتاه‌مدت قیمت (ثانیه) — درخواست‌های پشت‌سرهم از همین کش پاسخ می‌گیرند
PRICE_CACHE_TTL=60
# قدیمی‌تر از این، «کهنه» علامت می‌خورد و صریحاً برچسب‌دار نمایش داده می‌شود
PRICE_STALE_AFTER=900
# قدیمی‌تر از این، دیگر نمایش داده نمی‌شود (صادقانه «در دسترس نیست»)
PRICE_EXPIRE_AFTER=3600

# --- شبکه -------------------------------------------------------------------
HTTP_TIMEOUT=10
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_BASE=0.5
HTTP_BACKOFF_MAX=8

# مدارشکن: پس از این تعداد خطای پیوسته، منبع مدتی کنار گذاشته می‌شود
PROVIDER_BREAKER_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN=120

# نگهداری تاریخچهٔ قیمت (روز)
HISTORY_RETENTION_DAYS=90

# --- هشدار ------------------------------------------------------------------
# فاصلهٔ بررسی شرط‌ها در پس‌زمینه (ثانیه)
ALERT_CHECK_INTERVAL=120
MAX_ALERTS_PER_USER=15
# کمینهٔ فاصلهٔ بین دو اعلان برای یک هشدار (ثانیه)
ALERT_NOTIFY_COOLDOWN=600
# سقف اعلان هر کاربر در هر ساعت
ALERT_MAX_PER_HOUR=10
# پس از این تعداد خطای ارسال، هشدار خودکار غیرفعال می‌شود
ALERT_DISABLE_AFTER=5

# --- مسیرها و محیط ----------------------------------------------------------
# GHEMATYAR_DB_PATH=./data/ghematyar.db
# GHEMATYAR_DATA_DIR=./data
GHEMATYAR_ENV=development
