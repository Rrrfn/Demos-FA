# ---- copy to .env and adjust -------------------------------------------
# development | production | testing
HAMYAR_ENV=development

# port for `python -m app` (gunicorn reads $PORT from the platform)
PORT=5000

# SQLite file. Empty means <project>/data/hamyar.db
HAMYAR_DB_PATH=

# Flask session/CSRF signing key — set a real value in production
HAMYAR_SECRET_KEY=change-me-in-production

# When set, write endpoints require the X-Admin-Token header
HAMYAR_ADMIN_TOKEN=

# Retrieval thresholds (blended cosine similarity, 0..1)
HAMYAR_HIGH_CONF=0.52
HAMYAR_MED_CONF=0.30
HAMYAR_SUGGEST_FLOOR=0.12

# Out-of-domain gate. A match must be justified either by this much
# IDF-weighted coverage of the question, or by this much character overlap
# (which is what a misspelled or colloquial word looks like).
HAMYAR_EVIDENCE_FLOOR=0.45
HAMYAR_CHAR_SUPPORT=0.75
